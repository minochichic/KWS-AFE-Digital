# --- datasets (never commit; Colab re-downloads) ---
datasets/
*.wav
*.tar.gz
*.zip

# 예외: 동료 전송본은 낱개 CSV(161 MB / 38k 파일) 대신 tar 하나로 버전 관리한다.
# 위의 *.tar.gz 가 이걸 조용히 삼켜서 model_package_snapshot 만 커밋되고
# 정작 데이터는 빠진 적이 있다 (커밋 7252e30).
#
# 파일마다 예외를 한 줄씩 적다가 transfer_v4 에서 **똑같이 또 당했다** -- README 만
# 커밋되고 8 MB tar 는 빠진 채 push 됐다. `git add <디렉터리>` 는 무시된 파일을
# 말없이 건너뛰기 때문에 아무 경고도 없다. 그래서 글롭으로 바꾼다: 다음 전송본은
# 이 줄을 고치지 않아도 들어온다.
!analog/AFE_board/transfer_*/*.tar.gz

# --- experiment outputs ---
runs/
checkpoints/
*.pt
*.pth
*.ckpt
wandb/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- os / editor ---
.claude/settings.local.json
.DS_Store
.vscode/
.idea/

# --- local drafts / superseded copies (keep out of the tree, don't delete) ---
CLAUDE_1.md
TASK_afe_semantics_update.md
*.docx

# ngspice scratch
analog/AFE/netlists/_*.cir
analog/AFE/artifacts/afe16_tran.csv
analog/AFE/netlists/sim_*.cir
analog/AFE/artifacts/sim_*.csv
analog/AFE/artifacts/_t_*.csv

# --- generated notebooks (source of truth is the make_*.py next to them) ---
# lab.ipynb is rewritten wholesale by make_lab.py, and Jupyter writes execution
# counts + outputs back into it on every run -- so a tracked copy conflicts on
# every single pull. Regenerate instead: python3 notebooks/make_lab.py
notebooks/lab.ipynb
# rtl/tb/vectors/ is COMMITTED -- small seeded fixtures the testbench
# needs on machines without torch. Waveforms are output, so ignored.
*.vcd
rtl/gen/active.vh
# 루트에 풀어놓은 동료 전송 폴더만. 앞의 / 가 없으면 어느 깊이든 잡아서
# analog/AFE_board/transfer_v3_native/ 까지 삼킨다 (실제로 삼켰다).
/transfer_v3_*/
/vpp_5mV/
/vthr_*/

# --- Vivado ---
# 합성 산출물. rtl/.gitignore 에도 out/ 이 있지만 그건 rtl/out/ 만 잡는다 --
# build.tcl 과 build_bringup.tcl 은 **리포 루트로 cd 한 뒤** out/ 에 쓰므로
# 루트에 생긴다. 비트스트림·체크포인트·리포트라 전부 재생성 가능하다.
/out/

# 도구가 **현재 디렉터리**에 흘리는 것들. 이름이 vivado_<pid>.backup.* 로도
# 나와서 글롭이 필요하다.
#
# -nolog -nojournal 로 아예 안 만들 수도 있지만 **합성에는 붙이지 않는다**:
# 나중에 경고를 뒤질 유일한 기록이 로그다 (rtl/build.tcl 이 리포트를 out/ 에
# 따로 쓰지만, 로그에만 있는 INFO/WARNING 이 많다).
vivado*.jou
vivado*.log
vivado*.str
.Xil/
# 배치 모드에서 in-memory 프로젝트를 쓰므로 .xpr 은 안 생겨야 정상이다. GUI 를
# 실수로 켜서 프로젝트를 만들었을 때 커밋되지 않도록 막아 둔다 -- 그 흐름은
# 이 리포의 방식이 아니다 (rtl/RUNNING.md 5).
*.xpr
*.cache/
*.hw/
*.runs/
*.sim/

# Vivado Simulator (XSim). Logs and waveform databases are written under
# /out/ by rtl/run_xsim.ps1; xelab still creates its compiled snapshot here.
/xsim.dir/
xvlog.pb
xelab.pb
xsim*.jou
