* ---- analyses -------------------------------------------------------
.control
op
echo ''
echo '--- shared nodes -------------------------------------'
print v(vin) v(v_max) v(v_ref)
echo ''
echo '--- per channel: envelope, threshold, comparator ------'
print v(ve0) v(vt0) v(vo0)
print v(ve1) v(vt1) v(vo1)
print v(ve2) v(vt2) v(vo2)
print v(ve3) v(vt3) v(vo3)
print v(ve4) v(vt4) v(vo4)
print v(ve5) v(vt5) v(vo5)
print v(ve6) v(vt6) v(vo6)
print v(ve7) v(vt7) v(vo7)
print v(ve8) v(vt8) v(vo8)
print v(ve9) v(vt9) v(vo9)
print v(ve10) v(vt10) v(vo10)
print v(ve11) v(vt11) v(vo11)
print v(ve12) v(vt12) v(vo12)
print v(ve13) v(vt13) v(vo13)
print v(ve14) v(vt14) v(vo14)
print v(ve15) v(vt15) v(vo15)

.endc

.end
